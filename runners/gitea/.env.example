# источник: nii-energomash/automation/runners/gitea/.env.example
# место: <runner-dir>/.env

# Значения для docker-compose.yaml раннера. Сам .env остаётся на хосте и
# никуда не копируется: в нём лежит регистрационный токен.

# Адрес инстанса, тот же, что открывается в браузере, вместе с портом.
GITEA_INSTANCE_URL=https://<gitea-host>:<gitea-port>

# Регистрационный токен — не токен доступа. Берётся в настройках раннеров
# организации или инстанса, смотря где раннер регистрируется, и нужен только
# в момент регистрации: дальше раннер работает по .runner в ./data.
GITEA_RUNNER_REGISTRATION_TOKEN=

# Имя, под которым раннер виден в Gitea. В живой настройке собрано из имени
# машины и владельца: <машина>-<владелец>-runner.
GITEA_RUNNER_NAME=<runner-name>
