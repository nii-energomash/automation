# источник: nii-energomash/automation/project/npm/.npmrc
# место: .npmrc

# Лок пишется без ключа resolved, то есть без адреса тарбола в конкретном
# реестре. Пакет берётся из того реестра, который настроен у площадки, а версии
# и integrity в локе остаются — дерево зависимостей не переразрешается.
# Реестров и токенов здесь нет намеренно: проектный конфиг старше
# пользовательского и перекрыл бы площадочную настройку.
omit-lockfile-registry-resolved=true
