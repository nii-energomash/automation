# источник: nii-energomash/automation/deploy/systemd/dotnet/api.env.example
# место: deploy/api.env.example

# Шаблон файла окружения службы .NET-сервиса.
#
# Ставится в /etc/example/api.env с правами 0640 и владельцем root:example —
# внутри пароли к базе данных. Каталог лежит вне /opt/example/api, поэтому
# переживает обновление сервиса: заменяется только каталог установки.
#
# Формат читает systemd, а не оболочка: подстановки переменных и раскрытия ~ не
# происходит, кавычки не нужны, точка с запятой в строке подключения безопасна.
#
# Двойное подчёркивание в именах — разделитель уровней конфигурации ASP.NET
# Core: ConnectionStrings__DefaultConnection перекрывает ConnectionStrings:
# DefaultConnection из appsettings.json, а __0__ адресует элемент массива.
#
# Здесь только каркас: значения, которые есть у любого сервиса. Ключи,
# описывающие устройство конкретного проекта — адреса смежных сервисов, серверы
# Swagger, — добавляются в его собственную копию.

# --- База данных -----------------------------------------------------------

# Обязательна. Значения по умолчанию в appsettings.json нет: без этой переменной
# сервис не стартует, и это осознанный отказ вместо тихого подключения к чужой
# базе.
ConnectionStrings__DefaultConnection=Host=<db-host>;Port=<db-port>;Database=<db-name>;Username=<db-user>;Password=

# --- Сеть ------------------------------------------------------------------

# В appsettings.json Kestrel обычно прибит к 127.0.0.1, и снаружи машины сервис
# недоступен. Если к API обращаются из браузера напрямую, отдельным origin, —
# адрес должен быть внешним, а порт открыт в файерволе.
#
# Перекрыть можно только этим же ключом: секция Kestrel:Endpoints имеет
# приоритет над ASPNETCORE_URLS и ASPNETCORE_HTTP_PORTS.
Kestrel__Endpoints__Http__Url=http://+:<api-port>

# Origin, с которого приходит SPA. Совпадает с server_name в конфигурации
# хостового nginx.
#
# Задаются все элементы массива, а не только изменившиеся: переменные окружения
# умеют перекрыть элемент по индексу, но не сократить массив, — незаданный
# элемент остался бы со значением для разработки.
CorsPolicy__Origins__0=http://<spa-origin>
CorsPolicy__Origins__1=http://<spa-origin-alt>
