# источник: nii-energomash/automation/deploy/systemd/python/api.env.example
# место: deploy/api.env.example

# Шаблон файла окружения службы python-сервиса.
#
# Ставится в /etc/example/api.env с владельцем root:example и правами 0640.
# Каталог лежит вне /opt/example/api, поэтому переживает обновление сервиса:
# заменяется только каталог установки.
#
# Формат читает systemd, а не оболочка: подстановки переменных и раскрытия ~ не
# происходит, кавычки не нужны.
#
# Обязательных значений здесь нет: со всеми строками закомментированными служба
# поднимается на умолчаниях. Раскомментировать нужно то, что на этой машине
# отличается.

# Порт, который слушает сервис. Имя выбрано не произвольно: контейнерные
# платформы подставляют PORT сами, и сервис читает его одинаково — и в
# контейнере, и здесь.
#PORT=<api-port>

# Имя сервиса в ответе /info. Менять есть смысл, только если на машине поднято
# несколько экземпляров и их нужно различать.
#API_SERVICE_NAME=example-api

# Версия в ответе /info. Перекрывает файл src/API_VERSION, который заполняется
# при сборке релиза. Задавать вручную нужно лишь при развёртывании из
# исходников, где в файле лежит 0.0.0-dev.
#API_VERSION=
